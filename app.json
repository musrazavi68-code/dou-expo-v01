{
  "expo": {
    "name": "Dou Expo Beta",
    "slug": "dou-expo-v2",
    "version": "2.2.2",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#080B12"
    },
    "android": {
      "package": "com.mrazavi.douexpo.v2",
      "versionCode": 24,
      "permissions": [
        "CAMERA"
      ],
      "minSdkVersion": 26
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dou Expo برای عکاسی دابل‌اکسپوژر به دوربین نیاز دارد."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dou Expo برای انتخاب عکس به گالری نیاز دارد.",
          "cameraPermission": "Dou Expo برای ثبت عکس به دوربین نیاز دارد."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "اجازه ذخیره عکس‌های ساخته‌شده را بدهید.",
          "savePhotosPermission": "اجازه ذخیره عکس‌های ساخته‌شده را بدهید."
        }
      ]
    ],
    "extra": {
      "appVersion": "2.2.1",
      "developer": "M.Razavi"
    }
  }
}
